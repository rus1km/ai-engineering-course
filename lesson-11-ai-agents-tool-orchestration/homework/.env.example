# --- LLM provider ---
# Один з двох: OpenRouter (для дешевих моделей як Haiku) або Anthropic direct
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ANTHROPIC_API_KEY=sk-ant-...

# --- Models ---
# Дешева модель для простих ролей (Router, Safety)
MODEL_FAST=anthropic/claude-haiku-4-5
# Сильна модель для аналітичних та advisory ролей
MODEL_SMART=anthropic/claude-sonnet-4-6
# Модель для single-agent baseline
MODEL_BASELINE=anthropic/claude-sonnet-4-6
# Judge LLM для evaluation
MODEL_JUDGE=anthropic/claude-sonnet-4-6

# --- LangSmith (для tracing та experiments) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=personal-finance-coach
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Data ---
TRANSACTIONS_CSV=starter/data/transactions.csv

# --- App ---
APP_ENV=dev
API_BASE_URL=http://localhost:8000
MAX_AGENT_ITERATIONS=6
LLM_TIMEOUT_SECONDS=30
