# Naive baseline — no optimizations, everything in one stage.
# Goal: produce an image to compare against the optimized Dockerfile.
FROM python:3.11

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir -r app/requirements.txt

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
